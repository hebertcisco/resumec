{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hebertcisco.github.io/resumec/schemas/theme.schema.json",
  "title": "resumec theme schema",
  "type": "object",
  "required": ["schema_version", "name", "palette", "typography", "spacing", "layout", "sections"],
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "ats_safe": { "type": "boolean" },
    "palette": {
      "type": "object",
      "required": ["primary", "secondary", "accent", "text", "muted"],
      "properties": {
        "primary": { "$ref": "#/$defs/color" },
        "secondary": { "$ref": "#/$defs/color" },
        "accent": { "$ref": "#/$defs/color" },
        "text": { "$ref": "#/$defs/color" },
        "muted": { "$ref": "#/$defs/color" }
      }
    },
    "typography": {
      "type": "object",
      "required": ["font_family", "base_size_pt", "heading_size_pt"],
      "properties": {
        "font_family": { "type": "string", "minLength": 1 },
        "base_size_pt": { "type": "number", "minimum": 8 },
        "heading_size_pt": { "type": "number", "minimum": 10 }
      }
    },
    "spacing": {
      "type": "object",
      "required": ["section_gap_pt", "item_gap_pt"],
      "properties": {
        "section_gap_pt": { "type": "number", "minimum": 0 },
        "item_gap_pt": { "type": "number", "minimum": 0 },
        "page_margin_pt": { "type": "number", "minimum": 12 }
      }
    },
    "layout": {
      "type": "object",
      "required": ["columns"],
      "properties": {
        "columns": { "type": "integer", "enum": [1, 2] }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "enum": ["basics", "summary", "work", "education", "skills", "certifications", "projects", "languages", "awards"]
          },
          "visible": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    }
  }
}
